{
  "name": "@wrenautomation/kestrel",
  "version": "0.0.0",
  "description": "Review the design, not the code. Generates a repo's structure (imports, interfaces, schema, systems) into files in git, diffs it against what you approved, and shows the drift.",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "bin": {
    "kestrel": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js && vite build --config viewer/vite.config.ts --logLevel warn",
    "test": "vitest run --dir src",
    "gates": "lockf -t 900 /tmp/wren_automation-checks.lock sh -c 'pnpm lint && pnpm typecheck && pnpm test'"
  },
  "dependencies": {
    "@cdktf/hcl2json": "0.21.0",
    "@testcontainers/postgresql": "12.1.0",
    "bundle-require": "5.1.0",
    "commander": "15.0.0",
    "dependency-cruiser": "18.6.0",
    "esbuild": "0.28.2",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "smol-toml": "1.9.1",
    "ts-morph": "28.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wrenautomation/orrery": "link:../orrery",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "4.6.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@9.15.0"
}
